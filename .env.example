# Copy to .env.local and fill in real values. Never commit .env.local.

# Breeth Graph Memory
BREETH_API_KEY=
BREETH_API_URL=https://api.thebreeth.com
BREETH_TIMEOUT_MS=8000

# Gemini (dynamic interview turns + feedback synthesis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=20000

# Auth. Required in production (NODE_ENV=production) or when INTERVIEW_REQUIRE_AUTH=true.
# Browser UI uses an httpOnly signed cookie from GET /api/csrf.
# External API clients send x-api-key or Authorization: Bearer.
INTERVIEW_API_KEY=
UI_SESSION_SECRET=
INTERVIEW_REQUIRE_AUTH=

# Session store: memory (default), file (single node), or upstash (multi-instance / serverless)
SESSION_STORE=memory
SESSION_STORE_PATH=data/kv
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_STORE=
SESSION_TTL_MS=1800000
MAX_SESSIONS=500
SESSION_LOCK_TTL_SEC=45

# Request limits
MAX_BODY_BYTES=65536
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
