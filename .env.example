# Copy to .env.local and fill in real values. Never commit .env.local.

# Breeth Graph Memory
BREETH_API_KEY=
BREETH_API_URL=https://api.thebreeth.com
BREETH_TIMEOUT_MS=8000

# Gemini (dynamic interview turns + feedback synthesis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=20000

# Optional production hardening. Leave INTERVIEW_API_KEY empty for local/spec mode.
INTERVIEW_API_KEY=
SESSION_TTL_MS=1800000
MAX_SESSIONS=500
MAX_BODY_BYTES=65536
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
